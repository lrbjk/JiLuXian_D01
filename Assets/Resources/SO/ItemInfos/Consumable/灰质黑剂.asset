  ItemIcon: {fileID: 21300000, guid: e27ae617c4e4181479a3f43bd0285d35, type: 3}
  ItemName: "\u7070\u8D28\u9ED1\u5242"
  ItemDescription: "\u9ED1\u8272\u7684\u9488\u5242\u5916\u58F3\u4E2D\uFF0C\u7070\u8272\u7684\u7269\u8D28\u5728\u5176\u4E2D\u6F02\u6D6E\u6D41\u52A8\uFF0C\u662F\u4EBA\u7C7B\u667A\u6167\u7684\u7ED3\u6676\u3002
    \u80FD\u5C06\u6536\u96C6\u597D\u7684\u7070\u571F\u8F6C\u5316\u4E3A\u53EF\u88AB\u5438\u6536\u7684\u7269\u8D28\uFF0C\u4F7F\u7528\u4FBF\u53EF\u6062\u590D\u4E13\u6CE8\u503C\u3002
    \u4E3A\u4E86\u80FD\u8BA9\u5BFB\u7070\u8005\u66F4\u597D\u5904\u7406\u4E0D\u540C\u6218\u6597\uFF0C\u4EBA\u4EEC\u5C06\u7070\u8D28\u5242\u8FDB\u884C\u518D\u6539\u8FDB\uFF0C\u7EC8\u4E8E\u83B7\u5F97\u6B64\u7ED3\u679C\u3002
    \u4E3A\u4FBF\u4E8E\u533A\u5206\uFF0C\u4FBF\u5C06\u5176\u7528\u9ED1\u8272\u5BB9\u5668\u6536\u7EB3\u3002"
  ItemEffectDescription: "\u80FD\u5C06\u6536\u96C6\u597D\u7684\u7070\u571F\u8F6C\u5316\u4E3A\u53EF\u88AB\u5438\u6536\u7684\u7269\u8D28\uFF0C\u4F7F\u7528\u4FBF\u53EF\u6062\u590D\u4E13\u6CE8\u503C\u3002
    \u9053\u5177\u63CF\u8FF0\uFF1A"
